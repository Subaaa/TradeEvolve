# --- LLM -------------------------------------------------------------------
# The researcher. It reads the trade journal and proposes bounded parameter
# changes; it never places an order and never sees a broker credential.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3
# Hard daily cap, enforced against the llm_calls table (not an in-memory
# counter), so a restart cannot reset the day's spend.
LLM_DAILY_HARD_TOKEN_CAP=400000

# --- Alpaca (paper trading only) -------------------------------------------
# ALPACA_SYMBOL is a gold-backed crypto token (1 token = 1 troy oz) used as
# the XAU/USD proxy, because Alpaca has no forex or CFD gold market. Keys
# come from app.alpaca.markets (Paper Trading -> API Keys).
# The client refuses to construct against a non-paper base URL.
ALPACA_API_KEY_ID=replace-me
ALPACA_API_SECRET_KEY=replace-me
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_SYMBOL=PAXG/USD
# Order submission and cancellation. Off by default: a read-only inspection
# run should not be able to trade by accident.
ALPACA_WRITE_ENABLED=false

# --- App -------------------------------------------------------------------
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_HTTP_HOST=127.0.0.1
APP_HTTP_PORT=8080

# --- Strategy --------------------------------------------------------------
INITIAL_PAPER_EQUITY_USD=10000.0
INSTRUMENT=XAU_USD
GRANULARITY=M15
CHAMPION_BOOTSTRAP_CONFIG=pinned/strategies/pullback_paxg_m15_v1.json

# --- Storage ---------------------------------------------------------------
# One SQLite file. WAL mode; append-only guarantees are enforced by triggers.
DB_PATH=data/tradeevolve.sqlite
