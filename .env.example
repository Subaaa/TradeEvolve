# --- LLM -----------------------------------------------------------------
# MiniMax-M3 via the OpenAI-compatible base URL.
MINIMAX_API_KEY=sk-replace-me
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
# Daily token soft cap (degraded LLM mode above this); hard cap above 2x.
LLM_DAILY_SOFT_TOKEN_CAP=100000
LLM_DAILY_HARD_TOKEN_CAP=200000

# --- Supabase ------------------------------------------------------------
# Used for non-journal reads and writes.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey-replace-me
# A separate Postgres connection (direct, not via PostgREST) used for
# journal inserts under a custom role with INSERT-only grants.
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.replace-me.supabase.co:5432/postgres
SUPABASE_JOURNAL_DB_URL=postgresql://journal_writer:replace-me@db.replace-me.supabase.co:5432/postgres

# --- Alpaca MCP subprocess -------------------------------------------------
# These are read by the Alpaca MCP subprocess, not the parent. Paper
# trading only. ALPACA_SYMBOL is a gold-backed crypto token (1 token = 1
# troy oz of gold) used as the XAU/USD proxy -- Alpaca has no forex/CFD
# gold market. Get keys from app.alpaca.markets (Paper Trading -> API Keys).
ALPACA_API_KEY_ID=replace-me
ALPACA_API_SECRET_KEY=replace-me
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_SYMBOL=PAXG/USD
ALPACA_MCP_WRITE_ENABLED=true
# Hard kill switch: a Python-level const the rest of the code reads.
LIVE_TRADING_ENABLED=false

# --- App ----------------------------------------------------------------
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC
APP_HTTP_HOST=127.0.0.1
APP_HTTP_PORT=8080

# --- Strategy & risk ----------------------------------------------------
INITIAL_PAPER_EQUITY_USD=10000.0
INSTRUMENT=XAU_USD
GRANULARITY=H1

# --- Alerts -------------------------------------------------------------
ALERT_WEBHOOK_URL=
