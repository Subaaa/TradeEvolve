[Unit]
Description=nito-trade-research paper-trading agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/nito-trade-research
Environment="PYTHONPATH=/opt/nito-trade-research"
EnvironmentFile=/opt/nito-trade-research/.env
ExecStart=/opt/nito-trade-research/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nito-trade-research/data/backups

[Install]
WantedBy=multi-user.target
